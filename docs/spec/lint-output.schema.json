{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DrBaher/contract-lint-cli/blob/main/docs/spec/lint-output.schema.json",
  "title": "contract-lint --json report schema (v1)",
  "description": "The locked, machine-readable report emitted by `contract-lint <file> --json` (and `contract-lint demo --json`). Deterministic and byte-stable: it carries no timestamp so the output diffs cleanly in CI. `ok` and `exit_code` encode the gate decision under `fail_on`; agents branch on the exit code, not on prose. Each finding is { rule, severity, message, line, column?, excerpt }.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "version", "path", "format", "fail_on", "ok", "exit_code", "summary", "findings"],
  "$defs": {
    "severity": { "enum": ["error", "warning"] }
  },
  "properties": {
    "tool": { "const": "contract-lint" },
    "version": { "type": "string" },
    "path": { "type": "string", "description": "the linted path, or '-' for stdin" },
    "format": { "enum": ["markdown", "text", "html", "docx", "pdf"] },
    "fail_on": { "enum": ["error", "warning", "none"] },
    "ok": { "type": "boolean", "description": "true when no finding is at or above fail_on" },
    "exit_code": { "type": "integer", "enum": [0, 1] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "warning", "total", "by_rule"],
      "properties": {
        "error": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "by_rule": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "severity", "message", "line", "excerpt"],
        "properties": {
          "rule": { "type": "string", "description": "stable rule id; see `contract-lint rules --json`" },
          "severity": { "$ref": "#/$defs/severity" },
          "message": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 },
          "excerpt": { "type": "string" }
        }
      }
    }
  }
}
