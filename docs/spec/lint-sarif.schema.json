{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DrBaher/contract-lint-cli/blob/main/docs/spec/lint-sarif.schema.json",
  "title": "contract-lint SARIF 2.1.0 output schema (the subset we emit)",
  "description": "Validates the SARIF 2.1.0 document emitted by `contract-lint <file> --sarif` — the static-analysis interchange format consumed by GitHub code-scanning and other CI annotators. This is intentionally the SUBSET contract-lint produces (one run, one driver with the rule metadata, one result per finding), not the full OASIS SARIF schema. Each rule id is `contract-lint/<rule>` and each result carries a physicalLocation with a startLine.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "$schema", "runs"],
  "$defs": {
    "level": { "enum": ["error", "warning", "note"] }
  },
  "properties": {
    "version": { "const": "2.1.0" },
    "$schema": { "type": "string" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["tool", "results"],
        "properties": {
          "tool": {
            "type": "object",
            "required": ["driver"],
            "properties": {
              "driver": {
                "type": "object",
                "additionalProperties": true,
                "required": ["name", "version", "rules"],
                "properties": {
                  "name": { "const": "contract-lint" },
                  "version": { "type": "string" },
                  "informationUri": { "type": "string" },
                  "rules": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": true,
                      "required": ["id", "name", "shortDescription", "defaultConfiguration"],
                      "properties": {
                        "id": { "type": "string", "pattern": "^contract-lint/" },
                        "name": { "type": "string" },
                        "shortDescription": {
                          "type": "object",
                          "required": ["text"],
                          "properties": { "text": { "type": "string" } }
                        },
                        "defaultConfiguration": {
                          "type": "object",
                          "required": ["level"],
                          "properties": { "level": { "$ref": "#/$defs/level" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["ruleId", "level", "message", "locations"],
              "properties": {
                "ruleId": { "type": "string", "pattern": "^contract-lint/" },
                "level": { "$ref": "#/$defs/level" },
                "message": {
                  "type": "object",
                  "required": ["text"],
                  "properties": { "text": { "type": "string" } }
                },
                "locations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["physicalLocation"],
                    "properties": {
                      "physicalLocation": {
                        "type": "object",
                        "additionalProperties": true,
                        "required": ["artifactLocation", "region"],
                        "properties": {
                          "artifactLocation": {
                            "type": "object",
                            "required": ["uri"],
                            "properties": { "uri": { "type": "string" } }
                          },
                          "region": {
                            "type": "object",
                            "additionalProperties": true,
                            "required": ["startLine"],
                            "properties": {
                              "startLine": { "type": "integer", "minimum": 1 },
                              "startColumn": { "type": "integer", "minimum": 1 }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
